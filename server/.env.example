# Copy to .env and fill in. NEVER commit .env
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/payments-demo-db"
PORT=4000
CLIENT_URL=http://localhost:5173

# Stripe Dashboard -> Developers -> API keys (make sure TEST MODE / Sandbox is on)
STRIPE_SECRET_KEY=sk_test_xxx

# Printed by `stripe listen --events checkout.session.completed,checkout.session.expired --forward-to localhost:4000/api/webhook`
STRIPE_WEBHOOK_SECRET=whsec_xxx
